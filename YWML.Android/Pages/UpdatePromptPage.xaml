<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YWML.Android.Pages.UpdatePromptPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource OffBlack}">

    <Grid>
        <Border BackgroundColor="{StaticResource Secondary}"
                Stroke="{StaticResource Gray600}"
                StrokeThickness="1"
                Padding="20"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12"
                                 WidthRequest="320">
                <Label Text="UPDATE AVAILABLE"
                       FontFamily="monospace"
                       FontSize="18"
                       HorizontalOptions="Center" />
                <Label x:Name="MessageLabel"
                       FontSize="13"
                       TextColor="Gray" />
                <Button Text="Install now"
                        Clicked="OnInstall" />
                <Button Text="Later"
                        Clicked="OnLater" />
                <Button Text="Don't remind me of this update ever again"
                        Clicked="OnNever" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
