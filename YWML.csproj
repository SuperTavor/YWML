<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ywmlLogo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="config.toml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ywmlLogo.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.toml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="55.0.0" />
    <PackageReference Include="LZMA-CSWrapper" Version="19.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Samboy063.Tomlet" Version="6.2.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Src\Forms\MigrateModForm\MigrateModForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Src\FAMerger\DataClasses\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
    <Content Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YWML.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>